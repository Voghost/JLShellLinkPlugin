<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.jlshell.link</groupId>
        <artifactId>jlshell-link-plugins-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>link-program-plugin</artifactId>
    <properties>
        <jlshell.plugin.id>com.jlshell.link.program</jlshell.plugin.id>
        <jlshell.plugin.version>${project.version}</jlshell.plugin.version>
        <jlshell.plugin.scope>PROGRAM</jlshell.plugin.scope>
        <jlshell.link.runtime.bundle>${project.basedir}/../.runtime-bundle</jlshell.link.runtime.bundle>
    </properties>
    <dependencies>
        <dependency>
            <groupId>com.jlshell.link</groupId>
            <artifactId>link-plugin-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>net.oomn.jlshell</groupId>
            <artifactId>plugin-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Implementation-Version>${project.version}</Implementation-Version>
                            <JLShell-Plugin-Id>${jlshell.plugin.id}</JLShell-Plugin-Id>
                            <JLShell-Plugin-Version>${jlshell.plugin.version}</JLShell-Plugin-Version>
                            <JLShell-Plugin-Scope>${jlshell.plugin.scope}</JLShell-Plugin-Scope>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
            </plugin>
        </plugins>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
            <resource>
                <directory>${jlshell.link.runtime.bundle}</directory>
                <targetPath>META-INF/jlshell-link/runtime</targetPath>
                <filtering>false</filtering>
            </resource>
        </resources>
    </build>
</project>
